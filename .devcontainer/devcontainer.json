{
  "name": "MovieHub (React + Tailwind)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "React dev server", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss", "dbaeumer.vscode-eslint", "dsznajder.es7-react-js-snippets"]
    }
  }
}
