# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของตัวเอง (ไฟล์ .env จะไม่ถูก commit)
# ตัวแปรต้องขึ้นต้นด้วย REACT_APP_ เท่านั้น CRA ถึงจะส่งให้โค้ดฝั่งเบราว์เซอร์
# แก้ไฟล์นี้แล้วต้องหยุดและรัน npm start ใหม่

# API Key v3 ของ TMDB
REACT_APP_TMDB_KEY=

# ที่อยู่ Backend ของทีม: ปล่อยว่างไว้ = ใช้ mock ในเครื่อง (npm run mock ที่พอร์ต 4000 ผ่าน proxy ของ CRA)
# ตอนต่อ Go จริง ใส่เช่น https://api.ทีมเรา.xyz (บน Vercel ตั้งเป็น Environment Variable ชื่อเดียวกัน)
REACT_APP_API_URL=
